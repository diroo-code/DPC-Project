# Public browser configuration only. Never put a service role key or any server secret here.
# Anything prefixed VITE_ is compiled into the bundle and is visible to every visitor.

# Where the FastAPI backend runs. Leave empty in development to use the Vite proxy.
VITE_API_BASE_URL=

# Supabase project. Both must be set for real authentication to be active.
# The anon key is public by design. The service role key must never appear here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to 1 only for local development against the API without Supabase.
# It reveals a field where a locally issued token can be pasted. Never enable in production.
VITE_DEV_AUTH=
